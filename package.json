{
  "name": "sales-support-cctv",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_USE_SYSTEM_CA=1 next dev",
    "build": "next build",
    "start": "cross-env NODE_USE_SYSTEM_CA=1 next start",
    "lint": "next lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "export": "next build"
  },
  "dependencies": {
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.90.1",
    "@types/formidable": "^3.4.6",
    "formidable": "^3.5.4",
    "fuse.js": "^7.1.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^5.0.7",
    "next": "^14.1.0",
    "papaparse": "^5.5.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.11.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@types/xlsx": "^0.0.35",
    "autoprefixer": "^10.4.17",
    "cross-env": "^10.1.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>"
    ],
    "testMatch": [
      "**/*.test.ts"
    ],
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx"
    ],
    "collectCoverageFrom": [
      "**/*.{ts,tsx}",
      "!**/*.d.ts",
      "!**/node_modules/**",
      "!**/.next/**"
    ]
  }
}
